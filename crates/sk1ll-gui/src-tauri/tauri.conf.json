{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "0xSk1ll",
  "version": "0.3.0",
  "identifier": "app.v1p3r.sk1ll.desktop",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "0xSk1ll", "width": 1240, "height": 820, "minWidth": 800, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["../../../assets/branding/app-icon.png"] }
}
