<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd user agent for the 0xSk1ll daemon on macOS.

    sk1ll join https://server.example <join-code>
    mkdir -p ~/Library/LaunchAgents ~/Library/Logs/sk1ll
    sed "s|/Users/USER|$HOME|g" deploy/app.v1p3r.sk1ll.daemon.plist > ~/Library/LaunchAgents/app.v1p3r.sk1ll.daemon.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/app.v1p3r.sk1ll.daemon.plist
    launchctl kickstart -k gui/$(id -u)/app.v1p3r.sk1ll.daemon   # restart
    launchctl bootout gui/$(id -u)/app.v1p3r.sk1ll.daemon        # stop until the next login

  Logs: ~/Library/Logs/sk1ll/daemon.log (RUST_LOG=debug for more).

  While it runs, the daemon holds the repo's engine lock: sk1ll commands that
  change the repo go through it, and it refuses to start while another sk1ll
  process holds the lock (KeepAlive below retries). The machine token lives
  only in ~/Library/Application Support/sk1ll/daemon.json (mode 0600).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.v1p3r.sk1ll.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Adjust if sk1ll isn't in ~/.local/bin (the release archive's location). -->
    <string>/Users/USER/.local/bin/sk1ll</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- launchd's default PATH lacks Homebrew, where git may live. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>
  <!-- 0077: files it creates (state, snapshot, outbox, socket) are private to the user. -->
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/USER/Library/Logs/sk1ll/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/Library/Logs/sk1ll/daemon.log</string>
</dict>
</plist>
